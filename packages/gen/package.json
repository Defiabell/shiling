{
  "name": "@shiling/gen",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "node src/generate-creatures.ts",
    "generate:props": "node src/generate-props.ts",
    "validate": "node src/validate-glb.ts",
    "optimize": "node src/optimize-glb.ts",
    "optimize:props": "node src/optimize-props-glb.ts",
    "art": "node --import ./src/tsResolveHook.mjs src/generate-art.ts",
    "art:anchors": "node --import ./src/tsResolveHook.mjs src/generate-art.ts --anchors",
    "art:promote": "node --import ./src/tsResolveHook.mjs src/generate-art.ts --promote",
    "art:backfill": "node --import ./src/tsResolveHook.mjs src/backfill-illustrations.ts",
    "typecheck": "tsc --noEmit",
    "balance": "node --import ./src/tsResolveHook.mjs src/balance-sim.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@gltf-transform/cli": "^4.4.1"
  }
}
